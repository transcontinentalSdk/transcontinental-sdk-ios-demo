  "kind" : "symbol",
  "metadata" : {
    "externalID" : "TCDigitalFlyerUI",
    "modules" : [
      {
        "name" : "TCDigitalFlyerUI"
      }
    ],
    "role" : "collection",
    "roleHeading" : "Framework",
    "symbolKind" : "module",
    "title" : "TCDigitalFlyerUI"
  },
  "primaryContentSections" : [
    {
      "content" : [
        {
          "anchor" : "Getting-Started",
          "level" : 2,
          "text" : "Getting Started",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The instructions for installing and setting up the SDK are located in the ",
              "type" : "text"
            },
            {
              "identifier" : "https:\/\/github.com\/transcontinentalSdk\/transcontinental-sdk-ios",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " repo. The instructions for using the SwiftUI extensions are below.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Minimum-Requirements",
          "level" : 2,
          "text" : "Minimum Requirements",
          "type" : "heading"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "XCode (>= 16.1)",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "iOS (>= 15.0)",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "unorderedList"
        },
        {
          "anchor" : "Rendering-a-Publication",
          "level" : 2,
          "text" : "Rendering a Publication",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The FlyerViewUI is a custom view that serves as the entry point for displaying the digital flyer in SwiftUI. It accepts the attributes of a publication to display, along with a style extension that governs its visual behaviour.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "The FlyerViewUI is otherwise a fully controlled component, managing it’s own functionality and API calls internally.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "var body: some View {",
            "    FlyerViewUI(",
            "        digitalFlyer: digitalFlyer,",
            "        attributes: attributes",
            "    ) { event in",
            "        print(event) \/\/ This closure will be called when an event is emitted",
            "    }",
            "    .flyerStyle(.myCustomFlyerStyle)",
            "}"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "code" : "digitalFlyer",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " - The provisioned instance of the ",
                      "type" : "text"
                    },
                    {
                      "code" : "DigitalFlyer",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " to use",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "code" : "attributes",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " - The ",
                      "type" : "text"
                    },
                    {
                      "code" : "Publication.Attributes",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " object returned from ",
                      "type" : "text"
                    },
                    {
                      "code" : "listPublications(storeId:language:date:completion:)",
                      "type" : "codeVoice"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "code" : "event",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " - A ",
                      "type" : "text"
                    },
                    {
                      "code" : "FlyerView.Event",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " object that represents an event emitted by the FlyerView",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "code" : "flyerStyle",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " - A modifier that applies a custom style to the ",
                      "type" : "text"
                    },
                    {
                      "identifier" : "doc:\/\/tcdigitalflyerui.TCDigitalFlyerUI\/documentation\/TCDigitalFlyerUI\/FlyerViewUI",
                      "isActive" : true,
                      "type" : "reference"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "unorderedList"
        },
        {
          "anchor" : "Styling-the-UI",
          "level" : 2,
          "text" : "Styling the UI",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The default FlyerStyle is minimal and uses native styling where possible. As a result, users of the ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/tcdigitalflyerui.TCDigitalFlyerUI\/documentation\/TCDigitalFlyerUI\/FlyerViewUI",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " will want to create a custom style and apply that as a view modifier to the ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/tcdigitalflyerui.TCDigitalFlyerUI\/documentation\/TCDigitalFlyerUI\/FlyerViewUI",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ".",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "A custom style is of the form of:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "extension FlyerStyle {",
            "    static var myCustomFlyerStyle: Self {",
            "        Self(...)",
            "    }",
            "}"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
          "inlineContent" : [
            {
              "text" : "where ",
              "type" : "text"
            },
            {
              "code" : "Self",
              "type" : "codeVoice"
            },
            {
              "text" : " represents the ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/tcdigitalflyerui.TCDigitalFlyerUI\/documentation\/TCDigitalFlyerUI\/FlyerStyle",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " initialization.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "A simple customization is shown below, where only the Masthead’s logo is configured.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "extension FlyerStyle {",
            "    static var myCustomFlyerStyle: Self {",
            "        Self(",
            "            masthead: .init(",
            "                logo: Image(\"tc-logo\")",
            "            ),",
            "        )",
            "    }",
            "}"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
          "inlineContent" : [
            {
              "text" : "A fully custom style can be seen in the ",
              "type" : "text"
            },
            {
              "identifier" : "https:\/\/github.com\/transcontinentalSdk\/transcontinental-sdk-ios-demo",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ".",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Note: As the ",
              "type" : "text"
            },
            {
              "code" : "FlyerStyle",
              "type" : "codeVoice"
            },
            {
              "text" : " does not represent core rendering functionality, breaking changes to the style parameters will not result in a major SDK version update.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        }
      ],
      "kind" : "content"
    }
  ],
