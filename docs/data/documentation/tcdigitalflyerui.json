      "code" : "TCDigitalFlyerUI",
      "type" : "codeVoice"
    },
    {
      "text" : " contains extensions and components to integrate the Transcontinental iOS SDK into a SwiftUI application, while also providing an easily themeable search and filter UI.",
      "type" : "text"
    }
  ],
